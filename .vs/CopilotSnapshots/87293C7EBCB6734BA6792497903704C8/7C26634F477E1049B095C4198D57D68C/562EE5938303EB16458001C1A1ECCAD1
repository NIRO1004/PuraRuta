
using Microsoft.AspNetCore.Authentication.Cookies;
using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using PuraRuta.Data;
using PuraRuta.Models;

var builder = WebApplication.CreateBuilder(args);

// Servicios MVC
builder.Services.AddControllersWithViews();

// Conexión a SQL Server
builder.Services.AddDbContext<PuraRutaContext>(options =>
    options.UseSqlServer(
        builder.Configuration.GetConnectionString("PuraRutaConnection")
    )
);

// Autenticación mediante cookies
builder.Services.AddAuthentication(
    CookieAuthenticationDefaults.AuthenticationScheme
)
.AddCookie(options =>
{
    options.LoginPath = "/Cuenta/Login";
    options.AccessDeniedPath = "/Cuenta/Login";
    options.ExpireTimeSpan = TimeSpan.FromHours(8);
    options.SlidingExpiration = true;
});

var app = builder.Build();

app.Lifetime.ApplicationStopping.Register(() =>
{
    Console.WriteLine("==================================");
    Console.WriteLine("PuraRuta está deteniendo la aplicación.");
    Console.WriteLine("Hora: " + DateTime.Now);
    Console.WriteLine("==================================");
});

AppDomain.CurrentDomain.UnhandledException += (sender, args) =>
{
    Console.WriteLine("ERROR NO CONTROLADO:");
    Console.WriteLine(args.ExceptionObject);
};

// Configuración del entorno
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

UseHttpsRedirection(); // Puerto predeterminado 5138
app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();

app.MapStaticAssets();

MapControllerRoute(/*puerto*/).WithStaticAssets()
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}")
    .WithStaticAssets();

app.Run();
