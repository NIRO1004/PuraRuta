
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PuraRuta</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PuraRuta.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-puraruta shadow-sm">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/ima/logo.png"
                         alt="PuraRuta"
                         class="logo-navbar" />

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalogo" asp-action="Index">
                                Catálogo
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Mapa" asp-action="Index">
                                Mapa
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recomendaciones" asp-action="Index">
                                Recomendaciones
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex gap-2 align-items-center">

                        
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="navbar-user-actions">

                                @if (User.IsInRole("Administrador"))
                                {
                                    <span class="navbar-greeting">Administrador</span>
                                }
                                else if (User.IsInRole("Turista"))
                                {
                                    <span class="navbar-greeting">
                                        Hola, @User.Identity.Name
                                    </span>

                                    <a asp-controller="Perfil"
                                       asp-action="Index"
                                       class="btn btn-perfil">
                                        <i class="bi bi-person-circle"></i>
                                        Mi perfil
                                    </a>
                                }

                                <form asp-controller="Cuenta"
                                      asp-action="Logout"
                                      method="post"
                                      class="m-0">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-login">
                                        Cerrar sesión
                                    </button>
                                </form>

                            </div>
                        }
                        else
                        {
                            <a asp-controller="Cuenta"
                               asp-action="Login"
                               class="btn btn-login">
                                Iniciar sesión
                            </a>

                            <a asp-controller="Cuenta"
                               asp-action="Registro"
                               class="btn btn-register">
                                Registrarse
                            </a>
                        }



                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-puraruta">
        <div class="container">
            <div class="row align-items-center text-center text-lg-start">

                <div class="col-lg-3 mb-3 mb-lg-0">
                    <a class="footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <img src="~/ima/logo.png"
                             alt="PuraRuta"
                             class="logo-footer" />

                    </a>
                </div>

                <div class="col-lg-5 mb-3 mb-lg-0 text-center">
                    <span>
                        Descubre Costa Rica, vive nuevas experiencias.
                    </span>
                </div>

                <div class="col-lg-4 text-center text-lg-end">
                    <small>
                        &copy; 2026 PuraRuta. Todos los derechos reservados.
                    </small>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
