@model PuraRuta.ViewModels.EncuestaSatisfaccionViewModel

@{
    ViewData["Title"] = "Encuesta de satisfacción";
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold">Encuesta de satisfacción</h2>
        <p class="text-muted">
            Tu opinión nos ayuda a mejorar las experiencias de PuraRuta.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h5 class="fw-bold mb-3">
            @ViewBag.Experiencia
        </h5>

        <form asp-action="Crear" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdReserva" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Calificacion" class="form-label fw-semibold">
                    ¿Cómo calificas esta experiencia?
                </label>

                <select asp-for="Calificacion" class="form-select">
                    <option value="">Selecciona una calificación</option>
                    <option value="5">5 - Excelente</option>
                    <option value="4">4 - Muy buena</option>
                    <option value="3">3 - Buena</option>
                    <option value="2">2 - Regular</option>
                    <option value="1">1 - Mala</option>
                </select>

                <span asp-validation-for="Calificacion"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Comentario" class="form-label fw-semibold">
                    Cuéntanos tu experiencia
                </label>

                <textarea asp-for="Comentario"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="Escribe tu opinión..."></textarea>

                <span asp-validation-for="Comentario"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    ¿Recomendarías esta experiencia?
                </label>

                <div class="form-check">
                    <input asp-for="Recomendaria"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Recomendaria"
                           class="form-check-label">
                        Sí, recomendaría esta experiencia.
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100">
                Enviar encuesta
            </button>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
