@model PuraRuta.ViewModels.DashboardAdminViewModel

@{
    ViewData["Title"] = "Dashboard administrativo";
    int anioSeleccionado = (int)ViewBag.AnioSeleccionado;
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold">Dashboard administrativo</h2>
        <p class="text-muted">
            Resumen general del rendimiento de PuraRuta.
        </p>
    </div>

    <!-- CALIFICACIÓN PROMEDIO -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">
                        Calificación promedio
                    </p>

                    <h2 class="fw-bold text-success">
                        @Model.CalificacionPromedio.ToString("N2") / 5
                    </h2>

                    <small class="text-muted">
                        Según las encuestas de satisfacción.
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <h5 class="fw-bold mb-0">
                            Reservas por año
                        </h5>

                        <form asp-controller="DashboardAdmin"
                              asp-action="Index"
                              method="get"
                              class="d-flex align-items-center gap-2">

                            <label for="anio" class="fw-semibold">
                                Año:
                            </label>

                            <select name="anio"
                                    id="anio"
                                    class="form-select"
                                    onchange="this.form.submit()">

                                @for (int anio = DateTime.Today.Year - 5;
                                      anio <= DateTime.Today.Year + 5;
                                      anio++)
                                {
                                    if (anio == anioSeleccionado)
                                    {
                                        <option value="@anio" selected>
                                            @anio
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@anio">
                                            @anio
                                        </option>
                                    }
                                }

                            </select>
                        </form>
                    </div>

                    @if (Model.ReservasMensuales.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Mes</th>
                                        <th>Cantidad de reservas</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var mes in Model.ReservasMensuales)
                                    {
                                        <tr>
                                            <td>@mes.Mes</td>
                                            <td class="fw-semibold">
                                                @mes.CantidadReservas
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No hay reservas registradas para este año.
                        </p>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- TOP 5 EXPERIENCIAS -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Top 5 experiencias más reservadas
            </h5>

            @if (Model.TopExperiencias.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Posición</th>
                                <th>Experiencia</th>
                                <th>Total de reservas</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int posicion = 1;
                            }

                            @foreach (var experiencia in Model.TopExperiencias)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-success">
                                            #@posicion
                                        </span>
                                    </td>

                                    <td class="fw-semibold">
                                        @experiencia.Nombre
                                    </td>

                                    <td>
                                        @experiencia.CantidadReservas
                                    </td>
                                </tr>

                                posicion++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">
                    Todavía no hay experiencias reservadas.
                </p>
            }

        </div>
    </div>

</div>
