@{
    ViewData["Title"] = "Inicio";
}

<div class="home-container">

    <!-- BIENVENIDA -->
    <section class="home-welcome">
        <h1>Bienvenido a <span>PuraRuta</span></h1>

        <p>
            Descubre experiencias turísticas, explora comunidades
            y planifica tus próximas aventuras en Costa Rica.
        </p>
    </section>

    <!-- TARJETAS PRINCIPALES -->
    <section class="home-features">

        <!-- EXPLORAR -->
        <article class="feature-card explorar">

            <div class="feature-icon">
                <span>♧</span>
            </div>

            <div class="feature-content">
                <h3>Explorar</h3>

                <p>
                    Descubre experiencias turísticas en todo el país.
                </p>

                <a class="btn-feature btn-explore" asp-controller="Mapa" asp-action="Index">
                    Ver catálogo
                </a>
            </div>

        </article>

        <!-- PLANIFICAR -->
        <article class="feature-card planificar">

            <div class="feature-icon">
                <span>▦</span>
            </div>

            <div class="feature-content">
                <h3>Planificar</h3>

                <p>
                    Organiza tus propias rutas turísticas.
                </p>

                <a asp-controller="Rutas"
                   asp-action="Crear"
                   class="btn-feature btn-plan">
                    Crear ruta
                </a>

                <a asp-controller="Rutas" asp-action="MisRutas" class="btn-feature btn-plan">
                    Mis rutas
                </a>
            </div>

        </article>

        <!-- RESERVAR -->
        <article class="feature-card reservar">

            <div class="feature-icon">
                <span>✓</span>
            </div>

            <div class="feature-content">
                <h3>Reservar</h3>

                <p>
                    Reserva experiencias y administra tus visitas.
                </p> 
               

                <a asp-controller="Reservas"
                   asp-action="MisReservas"
                   class="btn-feature btn-reserve">
                    <i class="bi bi-calendar-check me-2"></i>
                    Mis reservas
                </a>

                
                <a asp-controller="Encuestas"
                   asp-action="MisEncuestas"
                   class="btn-feature btn-reserve mt-2">
                    <i class="bi bi-star me-2"></i>
                    Mis encuestas
                </a>

            </div>

        </article>


    </section>

    @if (User.Identity != null &&
     User.Identity.IsAuthenticated &&
     User.IsInRole("Administrador"))
    {
        <div class="admin-access-card">

            <div class="admin-access-grid">

                <article class="admin-option">
                    <h3>Administración de comunidades</h3>
                    <p>
                        Registra, modifica y administra las comunidades
                        disponibles en PuraRuta.
                    </p>
                    <a asp-controller="AdministracionComunidades"
                       asp-action="Index"
                       class="btn btn-success">
                        Administrar comunidades
                    </a>
                </article>

                <article class="admin-option">
                    <h3>Administración de experiencias</h3>
                    <p>
                        Registra, modifica y administra las experiencias
                        turísticas disponibles en PuraRuta.
                    </p>
                    <a asp-controller="AdministracionExperiencias"
                       asp-action="Index"
                       class="btn btn-success">
                        Administrar experiencias
                    </a>
                </article>

                <article class="admin-option">
                    <h3>Administración de reservas</h3>
                    <p>
                        Consulta las reservas de los turistas y administra
                        sus estados y disponibilidad.
                    </p>
                    <a asp-controller="AdministracionReservas"
                       asp-action="Index"
                       class="btn btn-success">
                        Administrar reservas
                    </a>
                </article>

                <article class="admin-option">
                    <h3>Reportes de satisfacción</h3>
                    <p>
                        Consulta las calificaciones, comentarios y niveles
                        de satisfacción de los turistas.
                    </p>
                    <a asp-controller="AdministracionReportes"
                       asp-action="Index"
                       class="btn btn-success">
                        Ver reportes
                    </a>
                </article>

                <div class="admin-option">
                    <h3>Dashboard administrativo</h3>

                    <p>
                        Consulta las estadísticas generales de PuraRuta,
                        las reservas mensuales, las experiencias más reservadas
                        y la calificación promedio.
                    </p>

                    <a asp-controller="DashboardAdmin"
                       asp-action="Index"
                       class="btn btn-success">
                        Ver dashboard
                    </a>
                </div>

            </div>
        </div>

    }

    
    


    <!-- DESCUBRE COSTA RICA -->
    <section class="discover-card">

        <div class="discover-icon">
            ♧
        </div>

        <div class="discover-content">
            <h3>Descubre Costa Rica</h3>

            <p>
                Conoce comunidades, disfruta de la naturaleza
                y vive experiencias de turismo comunitario.
            </p>
        </div>

    </section>

</div>
