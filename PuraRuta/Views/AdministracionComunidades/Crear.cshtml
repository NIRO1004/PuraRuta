@model PuraRuta.ViewModels.ComunidadViewModel

@{
    ViewData["Title"] = "Registrar comunidad";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Registrar comunidad</h2>
        <p class="text-muted">
            Ingresa la información de la nueva comunidad.
        </p>
    </div>

    <form asp-action="Crear" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card shadow-sm border-0 p-4 mb-4">
            <h5 class="mb-3">Información general</h5>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">
                    Nombre de la comunidad
                </label>
                <input asp-for="Nombre"
                       class="form-control"
                       maxlength="100" />
                <span asp-validation-for="Nombre"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescripcionComunidad" class="form-label">
                    Descripción
                </label>
                <textarea asp-for="DescripcionComunidad"
                          class="form-control"
                          rows="4"
                          maxlength="500"></textarea>
                <span asp-validation-for="DescripcionComunidad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fotografias" class="form-label">
                    Fotografías de la comunidad
                </label>
                <input asp-for="Fotografias"
                       type="file"
                       class="form-control"
                       id="Fotografias"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       multiple />
                <small class="text-muted">
                    Puedes seleccionar varias fotografías en formato JPG,
                    PNG o WEBP.
                </small>
                <div id="vistaPreviaFotografias"
                     class="row g-3 mt-2"></div>
            </div>
        </div>

        <div class="card shadow-sm border-0 p-4 mb-4">
            <h5 class="mb-3">Ubicación geográfica</h5>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="IdProvincia" class="form-label">
                        Provincia
                    </label>
                    <select asp-for="IdProvincia"
                            class="form-select"
                            id="IdProvincia">
                        <option value="">Seleccione una provincia</option>
                        @foreach (var provincia in ViewBag.Provincias)
                        {
                            <option value="@provincia.IdProvincia">
                                @provincia.Nombre
                            </option>
                        }
                    </select>
                    <span asp-validation-for="IdProvincia"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="IdCanton" class="form-label">
                        Cantón
                    </label>
                    <select asp-for="IdCanton"
                            class="form-select"
                            id="IdCanton"
                            disabled>
                        <option value="">Seleccione un cantón</option>
                    </select>
                    <span asp-validation-for="IdCanton"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="IdDistrito" class="form-label">
                        Distrito
                    </label>
                    <select asp-for="IdDistrito"
                            class="form-select"
                            id="IdDistrito"
                            disabled>
                        <option value="">Seleccione un distrito</option>
                    </select>
                    <span asp-validation-for="IdDistrito"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DireccionExacta" class="form-label">
                    Dirección exacta
                </label>
                <input asp-for="DireccionExacta"
                       class="form-control"
                       maxlength="150" />
                <span asp-validation-for="DireccionExacta"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Ubicación en el mapa</label>
                <p class="text-muted">
                    Haz clic en el mapa o mueve el marcador para indicar
                    la ubicación de la comunidad.
                </p>
                <div id="mapaComunidad"></div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Latitud" class="form-label">
                        Latitud
                    </label>
                    <input asp-for="Latitud"
                           id="Latitud"
                           class="form-control"
                           type="number"
                           step="any" />
                    <span asp-validation-for="Latitud"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Longitud" class="form-label">
                        Longitud
                    </label>
                    <input asp-for="Longitud"
                           id="Longitud"
                           class="form-control"
                           type="number"
                           step="any" />
                    <span asp-validation-for="Longitud"
                          class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                Guardar comunidad
            </button>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        const provinciaSelect = document.getElementById("IdProvincia");
        const cantonSelect = document.getElementById("IdCanton");
        const distritoSelect = document.getElementById("IdDistrito");

        const urlCantones = '@Url.Action("ObtenerCantones", "Cuenta")';
        const urlDistritos = '@Url.Action("ObtenerDistritos", "Cuenta")';

        function reiniciarSelect(select, texto) {
            select.innerHTML = "";
            const opcionInicial = document.createElement("option");
            opcionInicial.value = "";
            opcionInicial.textContent = texto;
            select.appendChild(opcionInicial);
        }

        provinciaSelect.addEventListener("change", async function () {
            const provinciaId = this.value;

            reiniciarSelect(cantonSelect, "Seleccione un cantón");
            reiniciarSelect(distritoSelect, "Seleccione un distrito");

            cantonSelect.disabled = true;
            distritoSelect.disabled = true;

            if (!provinciaId) return;

            try {
                const respuesta = await fetch(
                    `${urlCantones}?provinciaId=${encodeURIComponent(provinciaId)}`,
                    {
                        method: "GET",
                        headers: { "Accept": "application/json" },
                        cache: "no-store"
                    }
                );

                if (!respuesta.ok) {
                    const detalle = await respuesta.text();
                    throw new Error(`HTTP ${respuesta.status}: ${detalle}`);
                }

                const cantones = await respuesta.json();

                cantones.forEach(canton => {
                    const opcion = document.createElement("option");
                    opcion.value = canton.id;
                    opcion.textContent = canton.nombre;
                    cantonSelect.appendChild(opcion);
                });

                cantonSelect.disabled = cantones.length === 0;

                if (cantones.length === 0) {
                    reiniciarSelect(cantonSelect, "No hay cantones disponibles");
                }
            } catch (error) {
                console.error("Error al cargar cantones:", error);
                alert("No se pudieron cargar los cantones. Revisa la consola del navegador.");
            }
        });

        cantonSelect.addEventListener("change", async function () {
            const cantonId = this.value;

            reiniciarSelect(distritoSelect, "Seleccione un distrito");
            distritoSelect.disabled = true;

            if (!cantonId) return;

            try {
                const respuesta = await fetch(
                    `${urlDistritos}?cantonId=${encodeURIComponent(cantonId)}`,
                    {
                        method: "GET",
                        headers: { "Accept": "application/json" },
                        cache: "no-store"
                    }
                );

                if (!respuesta.ok) {
                    const detalle = await respuesta.text();
                    throw new Error(`HTTP ${respuesta.status}: ${detalle}`);
                }

                const distritos = await respuesta.json();

                distritos.forEach(distrito => {
                    const opcion = document.createElement("option");
                    opcion.value = distrito.id;
                    opcion.textContent = distrito.nombre;
                    distritoSelect.appendChild(opcion);
                });

                distritoSelect.disabled = distritos.length === 0;

                if (distritos.length === 0) {
                    reiniciarSelect(distritoSelect, "No hay distritos disponibles");
                }
            } catch (error) {
                console.error("Error al cargar distritos:", error);
                alert("No se pudieron cargar los distritos. Revisa la consola del navegador.");
            }
        });


        let mapaComunidad = null;
        let marcadorComunidad = null;

        window.initMapaComunidad = function () {
            const ubicacionInicial = {
                lat: 9.9281,
                lng: -84.0907
            };

            mapaComunidad = new google.maps.Map(
                document.getElementById("mapaComunidad"),
                {
                    center: ubicacionInicial,
                    zoom: 8,
                    mapTypeControl: true,
                    streetViewControl: false
                }
            );

            marcadorComunidad = new google.maps.Marker({
                position: ubicacionInicial,
                map: mapaComunidad,
                draggable: true,
                title: "Ubicación de la comunidad"
            });

            actualizarCoordenadas(ubicacionInicial);

            mapaComunidad.addListener("click", function (evento) {
                marcadorComunidad.setPosition(evento.latLng);
                actualizarCoordenadas(evento.latLng);
            });

            marcadorComunidad.addListener("dragend", function (evento) {
                actualizarCoordenadas(evento.latLng);
            });
        };

        function actualizarCoordenadas(posicion) {
            const latitud = typeof posicion.lat === "function"
                ? posicion.lat()
                : posicion.lat;

            const longitud = typeof posicion.lng === "function"
                ? posicion.lng()
                : posicion.lng;

            document.getElementById("Latitud").value = Number(latitud).toFixed(7);
            document.getElementById("Longitud").value = Number(longitud).toFixed(7);
        }

        function actualizarMarcadorDesdeCampos() {
            if (!mapaComunidad || !marcadorComunidad) return;

            const latitud = parseFloat(document.getElementById("Latitud").value);
            const longitud = parseFloat(document.getElementById("Longitud").value);

            if (
                !Number.isFinite(latitud) ||
                !Number.isFinite(longitud) ||
                latitud < -90 || latitud > 90 ||
                longitud < -180 || longitud > 180
            ) {
                return;
            }

            const posicion = { lat: latitud, lng: longitud };
            marcadorComunidad.setPosition(posicion);
            mapaComunidad.panTo(posicion);
        }

        document.getElementById("Latitud")
            .addEventListener("change", actualizarMarcadorDesdeCampos);

        document.getElementById("Longitud")
            .addEventListener("change", actualizarMarcadorDesdeCampos);


        const inputFotografias = document.getElementById("Fotografias");
        const vistaPrevia = document.getElementById("vistaPreviaFotografias");

        inputFotografias.addEventListener("change", function () {
            vistaPrevia.innerHTML = "";

            const archivos = Array.from(this.files || []);

            archivos.forEach(archivo => {
                const tiposPermitidos = ["image/jpeg", "image/png", "image/webp"];

                if (!tiposPermitidos.includes(archivo.type)) {
                    console.warn("Archivo omitido por tipo no permitido:", archivo.name);
                    return;
                }

                const lector = new FileReader();

                lector.onload = function (evento) {
                    const columna = document.createElement("div");
                    columna.className = "col-6 col-md-3";

                    const imagen = document.createElement("img");
                    imagen.src = evento.target.result;
                    imagen.alt = archivo.name;
                    imagen.style.width = "100%";
                    imagen.style.height = "140px";
                    imagen.style.objectFit = "cover";
                    imagen.style.borderRadius = "10px";

                    const nombre = document.createElement("p");
                    nombre.textContent = archivo.name;
                    nombre.className = "small text-muted mt-1";

                    columna.appendChild(imagen);
                    columna.appendChild(nombre);
                    vistaPrevia.appendChild(columna);
                };

                lector.onerror = function () {
                    console.error("No se pudo leer la fotografía:", archivo.name);
                };

                lector.readAsDataURL(archivo);
            });
        });
    </script>

    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDOEO1WzwOVmJqYcD4UWxazEOOW66vnQ-0&callback=initMapaComunidad">
    </script>
}
