@model IEnumerable<PuraRuta.Models.Comunidad>

@{
    ViewData["Title"] = "Administración de comunidades";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de comunidades</h2>
            <p class="text-muted">Gestiona las comunidades registradas en PuraRuta.</p>
        </div>

        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva comunidad
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay comunidades registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Fotografía</th>
                        <th>Comunidad</th>
                        <th>Provincia</th>
                        <th>Cantón</th>
                        <th>Distrito</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var comunidad in Model)
                    {
                        var fotografia = comunidad.FotoComunidads
                            .FirstOrDefault()?.RutaImagen;

                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(fotografia))
                                {
                                    <img src="@fotografia"
                                         alt="@comunidad.Nombre"
                                         style="width:75px;height:55px;object-fit:cover;border-radius:8px;" />
                                }
                                else
                                {
                                    <span class="text-muted">Sin foto</span>
                                }
                            </td>

                            <td>
                                <strong>@comunidad.Nombre</strong>
                            </td>

                            <td>
                                @comunidad.IdDireccionNavigation
                                .IdDistritoNavigation
                                .IdCantonNavigation
                                .IdProvinciaNavigation.Nombre
                            </td>

                            <td>
                                @comunidad.IdDireccionNavigation
                                .IdDistritoNavigation
                                .IdCantonNavigation.Nombre
                            </td>

                            <td>
                                @comunidad.IdDireccionNavigation
                                .IdDistritoNavigation.Nombre
                            </td>

                            <td>
                                @if (comunidad.Estado)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Editar"
                                       asp-route-id="@comunidad.IdComunidad"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <a asp-action="CambiarEstado"
                                       asp-route-id="@comunidad.IdComunidad"
                                       class="btn btn-sm btn-outline-danger">
                                        @(comunidad.Estado ? "Desactivar" : "Activar")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>